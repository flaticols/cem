{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@flaticols/cem",
  "version": "0.0.4",
  "exports": {
    ".": "./index.ts",
    "./cli": "./cli.ts"
  },
  "imports": {
    "typescript": "npm:typescript@^5.0.0"
  },
  "publish": {
    "include": [
      "index.ts",
      "types.ts",
      "analyzer.ts",
      "jsdoc.ts",
      "inheritance.ts",
      "runtime.ts",
      "cli.ts",
      "LICENSE",
      "README.md"
    ],
    "exclude": ["testdata", "node_modules", "*.json", "!jsr.json", "!package.json"]
  }
}
